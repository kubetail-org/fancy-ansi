{
  "name": "fancy-ansi",
  "version": "0.1.3",
  "description": "Small JavaScript library for converting ANSI to HTML",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kubetail-org/fancy-ansi.git"
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.14.0",
  "main": "./dist/main.cjs",
  "module": "./dist/main.js",
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "require": "./dist/main.cjs"
    },
    "./colors": {
      "import": "./dist/colors.js",
      "require": "./dist/colors.cjs"
    },
    "./plugin": {
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./react": {
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "build-bench": "vite build --config vite-bench.config.ts",
    "dev": "vite",
    "lint": "eslint \"./src/**/*.ts{,x}\"",
    "test": "vitest"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/benchmark": "^2.1.5",
    "@types/escape-html": "^1.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "ansi_up": "^6.0.6",
    "autoprefixer": "^10.6.1",
    "beautify-benchmark": "^0.2.4",
    "benchmark": "^2.1.4",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-storybook": "^0.8.0",
    "jsdom": "^24.1.3",
    "microtime": "^3.1.1",
    "postcss": "^8.5.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup-plugin-auto-external": "^2.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "escape-html": "^1.0.3"
  }
}
