{
  "name": "fancy-ansi",
  "version": "0.0.0-development",
  "description": "Small JavaScript library for converting ANSI to HTML",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kubetail-org/fancy-ansi.git"
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.14.0",
  "main": "./dist/main.cjs",
  "module": "./dist/main.js",
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "require": "./dist/main.cjs"
    },
    "./colors": {
      "import": "./dist/colors.js",
      "require": "./dist/colors.cjs"
    },
    "./plugin": {
      "style": "./dist/plugin.css"
    },
    "./react": {
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "build-bench": "vite build --config vite-bench.config.ts",
    "dev": "vite",
    "lint": "eslint \"./src/**/*.ts{,x}\"",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/benchmark": "^2.1.5",
    "@types/escape-html": "^1.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ansi_up": "^6.0.6",
    "beautify-benchmark": "^0.2.4",
    "benchmark": "^2.1.4",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "microtime": "^3.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup-plugin-auto-external": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "escape-html": "^1.0.3"
  }
}
