{
  "name": "fancy-ansi",
  "version": "0.0.0-development",
  "description": "Small JavaScript library for converting ANSI to HTML",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kubetail-org/fancy-ansi.git"
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.14.0",
  "main": "./dist/main.cjs",
  "module": "./dist/main.js",
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "require": "./dist/main.cjs"
    },
    "./colors": {
      "import": "./dist/colors.js",
      "require": "./dist/colors.cjs"
    },
    "./plugin": {
      "style": "./dist/plugin.css",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./react": {
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc && tsdown",
    "build-bench": "vite build --config vite-bench.config.ts",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "format": "oxfmt \"{bench,hack,src}/**/*.{ts,tsx,css}\" \"*.ts\" .oxlintrc.json .oxfmtrc.json",
    "lint": "oxlint && oxfmt --check \"{bench,hack,src}/**/*.{ts,tsx,css}\" \"*.ts\" .oxlintrc.json .oxfmtrc.json",
    "test": "vitest"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/benchmark": "^2.1.5",
    "@types/escape-html": "^1.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ansi_up": "^6.0.6",
    "beautify-benchmark": "^0.2.4",
    "benchmark": "^2.1.4",
    "jsdom": "^30.1.3",
    "microtime": "^3.1.1",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@types/react": "*",
    "react": "^18 || ^19",
    "tailwindcss": "^3 || ^4"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "escape-html": "^1.0.3"
  }
}
